# ---------------------------------------------------------------------------
# Modelo de lenguaje
# ---------------------------------------------------------------------------
#
# El razonamiento de la llamada corre EN LOCAL y no necesita ninguna credencial.
#
# No es una preferencia: el 6 de septiembre de 2026 Groq dejó de servir todo modelo Llama
# generativo en su nivel gratuito (`llama-3.3-70b-versatile` devuelve 404), y Google había
# retirado antes `gemini-2.0-flash` y `gemini-2.5-flash`. Depender de que un tercero siga
# sirviendo hoy el modelo que servía ayer es un riesgo innecesario en una demostración
# cronometrada. Los pesos en disco no los retira nadie.
#
#   LLM_BACKEND    dónde razona el agente:  ollama | gemini | groq
#   LLM_FALLBACK   a dónde cae si el primero falla (o `ninguno`)
#
# Con el default, la solución arranca sin una sola clave de API. Si además no hay Ollama
# corriendo, la conversación cae a Gemini en vez de morir.
#
# EL INTERCAMBIO, MEDIDO (mediana de 3 turnos, portátil i9-13900H sin GPU, Q4_K_M):
#
#   backend        por llamada al LLM   turno completo    a cambio de
#   ollama 3B            12,3 s            13–16 s        cero credenciales, el audio
#                                                         del paciente no sale del equipo
#   gemini flash          5,8 s             ~7 s          depende de red y de que el
#                                                         proveedor siga sirviendo
#
# El techo local de esta máquina son ~5,5 tokens/s, y es ancho de banda de memoria, no
# CPU: fijar `num_thread` a 6, 10, 14 o 20 no movió la cifra, y Ollama no aprovecha la
# iGPU Intel. En un equipo con GPU dedicada el reparto cambia por completo.
#
# Intercambiar los dos valores de abajo invierte la cadena sin tocar código.
LLM_BACKEND=ollama
LLM_FALLBACK=gemini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Mantiene el modelo cargado entre turnos y entre llamadas. Sin esto Ollama lo descarga de
# memoria tras 5 minutos de inactividad, y el primer turno de la llamada siguiente paga la
# recarga entera mientras el paciente espera en silencio.
OLLAMA_KEEP_ALIVE=2h

# `src/agente_postop/config.py` ABORTA el arranque si el modelo configurado no pertenece a
# una de las cuatro familias que permite el reto (compuerta G3), comprobando también el
# tamaño donde el reto lo acota: `llama3.1:8b` se rechaza, `llama3.2:3b` se acepta. La
# compuerta se defiende con código, no con disciplina.

# ---------------------------------------------------------------------------
# Credenciales (todas opcionales)
# ---------------------------------------------------------------------------
#
# GEMINI_API_KEY  solo si se usa Gemini como backend o como respaldo.
# GROQ_API_KEY    solo para el reconocimiento de voz (Whisper), que sigue disponible.
#                 Sin ella el agente razona igual; lo que se pierde es el habla del
#                 paciente, no la lógica clínica.
GROQ_API_KEY=
GEMINI_API_KEY=

# Claves adicionales, separadas por comas. Cuando la clave activa agota su cupo diario se
# rota a la siguiente de forma automática (src/agente_postop/clients.py); el error solo se
# propaga si todas están agotadas. Opcionales: si van vacías, se usa solo la primaria.
GROQ_API_KEYS_EXTRA=
GEMINI_API_KEYS_EXTRA=

# Alias "-latest" a propósito: stack-tecnico.md fija familias, no versiones, porque los
# proveedores retiran snapshots sin aviso. Fijar `gemini-2.5-flash` hoy da 404.
GEMINI_LLM_MODEL=gemini-flash-latest

# Responder una pregunta abierta del paciente es la única operación que redacta una frase
# entera (~160 tokens) en vez de clasificar (~10). En una CPU sin GPU eso son ~30 s con el
# paciente esperando, así que esa operación —y solo esa— sale a la nube.
#
# Medido sobre el prompt real, tres llamadas de cada uno:
#   gemini-flash-latest        mediana 33.138 ms   y respondía en INGLÉS
#   gemini-flash-lite-latest   mediana    802 ms   español correcto
#
# Los dos son gama Flash, así que la compuerta G3 se cumple igual. `ninguno` devuelve esta
# operación al backend por defecto (local).
LLM_RESPUESTAS=gemini
GEMINI_MODELO_RESPUESTAS=gemini-flash-lite-latest

# Reconocimiento de voz. `whisper-large-v3` sigue sirviéndose en Groq; es lo único que se
# le sigue pidiendo a ese proveedor.
GROQ_STT_MODEL=whisper-large-v3

# Solo se usa si LLM_BACKEND o LLM_FALLBACK valen `groq`. Ver la nota de arriba: hoy no
# hay ningún Llama generativo disponible en el nivel gratuito.
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Voz
# ---------------------------------------------------------------------------
#
#   edge   Microsoft Edge TTS, voz colombiana neuronal. Sin credenciales.
#   piper  síntesis local, funciona sin conexión. Solo tiene voces es_MX y es_ES.
#
# El default es `edge` por el acento: a un paciente colombiano recién operado le hablaba
# alguien de otro país. Edge depende de un servicio que nadie ha contratado y puede
# cortarse sin aviso, así que Piper se conserva y entra solo con que el otro falle.
#
# Cambiar de voz NO añade latencia a la llamada: las 16 frases del guion van
# pre-sintetizadas. Tras cambiarla hay que regenerarlas:
#     python -m agente_postop.voice.guion_audio
# El nombre de cada archivo incluye la voz, así que un cambio nunca reproduce la anterior.
#
# Voces colombianas disponibles: es-CO-SalomeNeural (F), es-CO-GonzaloNeural (M).
TTS_BACKEND=edge
EDGE_VOZ=es-CO-SalomeNeural

# ---------------------------------------------------------------------------
# Motor de triaje
# ---------------------------------------------------------------------------
#
# La criticidad la decide código determinista, no el modelo (clinical/triage.py).
#   conservador  (default) 142/160 de exactitud, 18 falsos positivos, 0 falsos negativos
#   optimo                 157/160 de exactitud,  3 falsos positivos, 0 falsos negativos
# El default es el conservador a propósito: cambia falsos positivos por margen de
# seguridad clínica, que es la dirección en la que la rúbrica pide equivocarse.
# Reproducir: python -m harness.eval_triaje --ambos-perfiles
TRIAGE_PROFILE=conservador

# ---------------------------------------------------------------------------
# Rutas y servidor
# ---------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma
VAULT_DIR=./vault
DATASET_DIR=./dataset

APP_HOST=0.0.0.0
APP_PORT=8000
