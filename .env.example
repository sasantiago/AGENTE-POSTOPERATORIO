# GROQ_API_KEY mueve la conversación; GEMINI_API_KEY, la extracción clínica del turno.
# Son cupos diarios SEPARADOS: repartir las dos llamadas entre ambos no divide el
# presupuesto, lo duplica (ver docs/informe-final.md §4.1).
GROQ_API_KEY=
GEMINI_API_KEY=

# Claves adicionales, separadas por comas. Cuando la clave activa agota su cupo diario se
# rota a la siguiente de forma automática (src/agente_postop/clients.py); el error solo se
# propaga si todas están agotadas. Opcionales: si van vacías, se usa solo la primaria.
GROQ_API_KEYS_EXTRA=
GEMINI_API_KEYS_EXTRA=

# Modelos
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3

# Alias "-latest" a propósito: stack-tecnico.md fija familias, no versiones, porque los
# proveedores retiran snapshots sin aviso (gemini-2.0-flash ya devuelve 404).
GEMINI_LLM_MODEL=gemini-flash-latest

# false devuelve la extracción a Groq sin tocar código. Ante cualquier fallo de Gemini la
# caída a Groq ya es automática; esto es para desactivarla del todo.
EXTRACCION_EN_GEMINI=true

# Rutas locales
CHROMA_PERSIST_DIR=./data/chroma
VAULT_DIR=./vault
DATASET_DIR=./dataset

# Servidor
APP_HOST=0.0.0.0
APP_PORT=8000
