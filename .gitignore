# LibreOffice/OpenOffice lock files — embed local username and LAN IP of whoever
# has the spreadsheet open, never useful to commit.
.~lock.*#

# Python bytecode cache
__pycache__/
*.pyc

# Claude Code local session config
.claude/

# Secretos y entornos locales
.env
.env.local

# Python
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Datos generados (modelo de voz, memoria, vault ingerido)
# data/chroma/ NO se ignora — el índice viene pre-construido y comiteado (ver README,
# sección de instalación: blinda la compuerta de arranque en ≤15 minutos, G2).
data/processed/
data/voices/
data/memoria/
src/agente_postop/voice/fillers/*.wav
vault/
*.log

# Node (consola web, si aplica)
node_modules/
dist/
